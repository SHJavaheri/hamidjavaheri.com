---
import Icon from './Icon.astro';
import { chapters, person } from '../data/site';
const total = String(chapters.length - 1).padStart(2, '0');
---
<div class="progress" aria-hidden="true"><i data-progress></i></div>
<header class="bar">
  <a class="mark" href="#opening" aria-label={`${person.name}, back to the opening`}>
    <i aria-hidden="true"></i><span>{person.name}</span>
  </a>

  <nav class="presenter" aria-label="Chapters">
    <p class="counter data" aria-live="polite" data-counter>
      <b>Opening</b>
    </p>
    <ol class="ticks" data-total={total}>
      {chapters.slice(1).map((c, i) => (
        <li>
          <a href={`#${c.id}`} data-tick={c.id}>
            <span class="sr-only">Chapter {String(i + 1).padStart(2, '0')}: {c.name}</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>

  <div class="ctrls">
    <button class="pill" type="button" data-theme-toggle aria-pressed="true">
      <span class="ic up"><Icon name="house-up" size={16} /></span>
      <span class="ic down"><Icon name="house-down" size={16} /></span>
      <span class="lbl" data-theme-label>House lights up</span>
    </button>

    <div class="sound" data-sound>
      <button class="pill" type="button" data-sound-toggle aria-pressed="false" aria-label="Sound: off">
        <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="lbl" data-sound-label>Sound off</span>
      </button>
      <div class="vol">
        <label class="sr-only" for="vol">Music volume</label>
        <input id="vol" type="range" min="0" max="40" step="1" value="5" data-volume />
        <output class="data" for="vol" data-volume-out>5%</output>
      </div>
    </div>
  </div>
</header>
<audio src="/media/ambient.mp3" loop preload="auto" data-audio></audio>

<style>
  .progress { position: fixed; inset: 0 0 auto; height: 2px; z-index: 62; pointer-events: none; }
  .progress i { display: block; height: 100%; background: linear-gradient(90deg, var(--gel), var(--gel-2)); transform-origin: 0 50%; transform: scaleX(0); }

  .bar {
    position: fixed; inset: 0 0 auto; z-index: 60;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px;
    padding: 14px var(--gutter);
    background: linear-gradient(to bottom, color-mix(in srgb, var(--bg) 88%, transparent) 30%, transparent);
  }
  .mark { display: inline-flex; align-items: center; gap: 10px; justify-self: start; font-weight: 800; font-stretch: 115%; letter-spacing: -0.03em; font-size: 15px; text-decoration: none; }
  .mark i { width: 8px; height: 8px; border-radius: 50%; background: var(--gel); box-shadow: 0 0 0 4px color-mix(in srgb, var(--gel) 22%, transparent); animation: rec 2.4s var(--ease-in-out) infinite; }
  @keyframes rec { 50% { opacity: 0.45; } }

  .presenter { display: flex; align-items: center; gap: 18px; }
  .counter { white-space: nowrap; min-width: 15ch; text-align: right; }
  .counter :global(b) { color: var(--fg); font-weight: 600; }
  .ticks { display: flex; gap: 4px; list-style: none; }
  .ticks a { display: block; width: 22px; height: 22px; position: relative; }
  .ticks a::after {
    content: ''; position: absolute; left: 3px; right: 3px; top: 10px; height: 2px; border-radius: 2px;
    background: var(--line-strong); transition: background-color 0.3s, transform 0.3s var(--ease-out);
  }
  .ticks a:hover::after { background: var(--fg); }
  .ticks a[aria-current='step']::after { background: var(--gel); transform: scaleY(1.8); }

  .ctrls { display: flex; gap: 8px; justify-self: end; align-items: center; }
  .pill {
    font-family: var(--mono); font-size: 10.5px; letter-spacing: 0.1em; text-transform: uppercase;
    display: inline-flex; align-items: center; gap: 8px; height: 36px; padding: 0 14px;
    border-radius: 999px; border: 1px solid var(--line-strong); cursor: pointer;
    background: color-mix(in srgb, var(--panel) 70%, transparent);
    backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);
    transition: border-color 0.25s, background-color 0.25s, transform 0.2s var(--ease-out);
  }
  .pill:hover { border-color: var(--gel); }
  .pill:active { transform: scale(0.97); }
  .ic { display: inline-flex; color: var(--gel-ink); }
  .ic.down { display: none; }
  :global([data-theme='dark']) .ic.up { display: none; }
  :global([data-theme='dark']) .ic.down { display: inline-flex; }

  .eq { display: inline-flex; gap: 2px; align-items: flex-end; height: 12px; width: 14px; }
  .eq i { width: 2px; height: 3px; border-radius: 1px; background: var(--faint); }
  .sound.on .eq i { background: var(--gel); animation: eq 1.1s var(--ease-in-out) infinite; }
  .sound.on .eq i:nth-child(2) { animation-delay: -0.35s; }
  .sound.on .eq i:nth-child(3) { animation-delay: -0.7s; }
  .sound.on .eq i:nth-child(4) { animation-delay: -0.15s; }
  @keyframes eq { 0%, 100% { height: 3px; } 50% { height: 12px; } }

  /* hover or focus the sound pill and the volume slider slides out */
  .sound { position: relative; display: flex; align-items: center; }
  .vol {
    position: absolute; right: 0; top: calc(100% + 8px);
    display: flex; align-items: center; gap: 10px; padding: 10px 14px;
    border-radius: 999px; border: 1px solid var(--line-strong); background: var(--panel);
    box-shadow: var(--shadow);
    opacity: 0; transform: translateY(-6px) scale(0.96); transform-origin: top right; pointer-events: none;
    transition: opacity 0.2s var(--ease-out), transform 0.25s var(--ease-out);
  }
  .sound::before { content: ''; position: absolute; inset: 100% 0 -12px; } /* hover bridge */
  .sound:hover .vol, .sound:focus-within .vol { opacity: 1; transform: none; pointer-events: auto; }
  .vol output { min-width: 4ch; text-align: right; color: var(--fg); }
  input[type='range'] { -webkit-appearance: none; appearance: none; width: 130px; height: 22px; background: transparent; cursor: pointer; }
  input[type='range']::-webkit-slider-runnable-track { height: 4px; border-radius: 4px; background: linear-gradient(90deg, var(--gel) var(--fill, 12.5%), var(--line-strong) var(--fill, 12.5%)); }
  input[type='range']::-moz-range-track { height: 4px; border-radius: 4px; background: var(--line-strong); }
  input[type='range']::-moz-range-progress { height: 4px; border-radius: 4px; background: var(--gel); }
  input[type='range']::-webkit-slider-thumb { -webkit-appearance: none; width: 16px; height: 16px; margin-top: -6px; border-radius: 50%; background: var(--fg); border: 3px solid var(--panel); box-shadow: 0 1px 4px rgb(0 0 0 / 0.3); }
  input[type='range']::-moz-range-thumb { width: 12px; height: 12px; border-radius: 50%; background: var(--fg); border: 3px solid var(--panel); }

  @media (max-width: 1000px) { .ticks { display: none; } }
  @media (max-width: 720px) {
    .bar { grid-template-columns: auto 1fr auto; padding: 10px 16px; background: color-mix(in srgb, var(--bg) 82%, transparent);
      backdrop-filter: blur(14px) saturate(1.2); -webkit-backdrop-filter: blur(14px) saturate(1.2); box-shadow: 0 1px 0 var(--line); }
    .presenter { justify-content: center; }
    .counter { min-width: 0; text-align: center; }
    .counter :global(.nm) { display: none; }
    .lbl { display: none; }
    .pill { width: 36px; padding: 0; justify-content: center; }
    .mark span { display: none; }
  }
</style>
