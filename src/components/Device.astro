---
/** Keynote product frames. Sizes are em-based: set font-size on the frame to scale the whole device. */
interface Props { kind: 'laptop' | 'phone' | 'browser'; class?: string; url?: string; [key: string]: unknown; }
const { kind, class: cls, url, ...rest } = Astro.props;
---
{kind === 'laptop' && (
  <div class:list={['laptop', cls]} {...rest}>
    <div class="lid"><div class="scr"><slot /></div></div>
    <div class="base" aria-hidden="true"></div>
  </div>
)}
{kind === 'phone' && (
  <div class:list={['phone', cls]} {...rest}>
    <div class="scr"><slot /></div>
  </div>
)}
{kind === 'browser' && (
  <div class:list={['browser', cls]} {...rest}>
    <div class="chrome" aria-hidden="true"><i></i><i></i><i></i>{url && <span class="url">{url}</span>}</div>
    <div class="view"><slot /></div>
  </div>
)}

<style is:global>
  .laptop { font-size: clamp(5.4px, 0.8vw, 11.5px); width: 66em; max-width: 100%; position: relative; }
  .lid { background: #0d0d0f; border-radius: 1.6em 1.6em 0.5em 0.5em; padding: 1.1em 1.1em 1.5em; box-shadow: 0 0 0 1px #2a2a2c inset, var(--shadow-lg); }
  .laptop .scr { aspect-ratio: 16 / 10; border-radius: 0.4em; overflow: hidden; position: relative; background: #fff; }
  .base { height: 1.5em; margin: 0 -5.5%; background: linear-gradient(#d6d6da, #9a9aa0); border-radius: 0 0 1.6em 1.6em; position: relative; }
  .base::before { content: ''; position: absolute; left: 50%; top: 0; width: 16%; height: 0.55em; transform: translateX(-50%); background: #85858b; border-radius: 0 0 0.6em 0.6em; }
  [data-theme='dark'] .base { background: linear-gradient(#3c3c40, #17171a); }

  .phone { font-size: clamp(6px, 0.82vw, 11px); width: 30em; aspect-ratio: 9 / 19.3; background: #0d0d0f; border-radius: 4.6em; padding: 1.05em; box-shadow: 0 0 0 1px #2c2c2e inset, 0 0 0 0.35em #1c1c1e, var(--shadow-lg); position: relative; }
  .phone .scr { width: 100%; height: 100%; border-radius: 3.6em; overflow: hidden; position: relative; background: #fff; }
  .phone .scr::before { content: ''; position: absolute; top: 1.1em; left: 50%; transform: translateX(-50%); width: 9em; height: 2.6em; border-radius: 2em; background: #000; z-index: 5; }

  .browser { font-size: clamp(5.4px, 0.76vw, 11px); width: 66em; max-width: 100%; border-radius: 1.2em; overflow: hidden; background: #fff; box-shadow: 0 0 0 1px var(--line), var(--shadow-lg); }
  .chrome { height: 3.2em; background: #ececef; display: flex; align-items: center; gap: 0.55em; padding: 0 1.2em; }
  .chrome i { width: 1.05em; height: 1.05em; border-radius: 50%; background: #d3d3d7; }
  .chrome i:nth-child(1) { background: #ff5f57; } .chrome i:nth-child(2) { background: #febc2e; } .chrome i:nth-child(3) { background: #28c840; }
  .url { margin-left: 1.4em; flex: 1; max-width: 32em; height: 1.9em; border-radius: 0.6em; background: #fff; color: #6e6e73; font: 500 1.1em/1.9em var(--display); padding-left: 1em; white-space: nowrap; overflow: hidden; }
  [data-theme='dark'] .chrome { background: #1d1d20; }
  [data-theme='dark'] .chrome .url { background: #2a2a2e; color: #a3a1aa; }
  .view { position: relative; overflow: hidden; aspect-ratio: 16 / 10; background: #fff; }
  .view img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
</style>
