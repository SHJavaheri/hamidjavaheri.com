---
import '../styles/global.css';
import { person, description } from '../data/site';

interface Props { title?: string; description?: string; }
const { title = `${person.name}: inventor, engineer, builder`, description: desc = description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: person.name,
  url: person.site,
  image: new URL('/media/profile.jpg', Astro.site).href,
  jobTitle: person.role,
  worksFor: { '@type': 'Organization', name: 'CIBC' },
  alumniOf: { '@type': 'CollegeOrUniversity', name: person.school },
  address: { '@type': 'PostalAddress', addressLocality: 'Toronto', addressCountry: 'CA' },
  email: `mailto:${person.email}`,
  sameAs: [person.linkedin, person.github, 'https://hublii.com'],
  knowsAbout: ['Software engineering', 'Product design', 'Systems integration', 'Next.js', 'TypeScript', 'AWS'],
};
---
<!doctype html>
<html lang="en" data-theme="light" data-gel="house">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={person.name} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fbfaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#050506" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={person.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Hamid Javaheri, on stage in the spotlight." />
    <meta property="profile:first_name" content="Hamid" />
    <meta property="profile:last_name" content="Javaheri" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preload" href="/media/profile.jpg" as="image" fetchpriority="high" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Before first paint: house lights up by default, or the visitor's last choice. -->
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem('hj-theme');
          if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
        } catch {}
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <div class="rig" aria-hidden="true"></div>
    <slot />
  </body>
</html>
